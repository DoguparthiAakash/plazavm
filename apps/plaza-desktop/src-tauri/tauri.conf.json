{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PlazaVM",
  "version": "0.1.0-dp1",
  "identifier": "com.plazavm.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "PlazaVM Workspaces — Developer Preview (DP1)",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "PlazaVM Project",
    "copyright": "Copyright (c) 2026 PlazaVM Contributors",
    "category": "Developer Tool",
    "shortDescription": "Universal Workspace Virtualization Platform",
    "longDescription": "PlazaVM is a modern, modular workspace virtualization platform abstracting containers, VMs, and cloud instances behind a single unified developer experience.",
    "fileAssociations": [
      {
        "ext": ["plaza", "workspace"],
        "name": "PlazaVM Workspace Manifest",
        "description": "PlazaVM Declarative Workspace Configuration",
        "role": "Editor"
      }
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "displayLanguageSelector": false
      }
    }
  }
}
