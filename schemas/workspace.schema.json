{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PlazaVM Workspace Model Schema",
  "type": "object",
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "name": { "type": "string" },
    "status": {
      "type": "object",
      "properties": {
        "state": { "type": "string", "enum": ["created", "scheduling", "running", "stopping", "stopped", "error", "destroyed"] },
        "assigned_backend": { "type": ["string", "null"] }
      },
      "required": ["state"]
    }
  },
  "required": ["id", "name", "status"]
}
